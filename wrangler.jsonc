{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gavriq-labs-global-website-prelaunch",
  "compatibility_date": "2026-09-03",

  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}